# ==========================================
# SZERVER MONITORING KONFIGURÁCIÓ
# ==========================================

# Mintavételezési gyakoriság másodpercben
CHECK_INTERVAL=3

# Küszöbértékek százalékban (0 - 100)
CPU_THRESHOLD=85.0
RAM_THRESHOLD=90.0
DISK_THRESHOLD=90.0

# Hány másodpercig kell a terhelésnek FOLYAMATOSAN fennállnia a riasztáshoz? (Spike-védelem)
ALERT_DURATION=30

# Spam-védelem: hány másodperc teljen el két riasztás között metrikánként
ALERT_COOLDOWN=300

# ------------------------------------------
# MEREVLEMEZEK ÉS PARTÍCIÓK
# Vesszővel elválasztott csatolási pontok (ha üres, az összes fizikai lemezt figyeli)
# Példa: /,/mnt/storage,D:\
# ------------------------------------------
MONITORED_DISKS=

# ------------------------------------------
# ÉRTESÍTÉSI CSATORNÁK (Opcionális)
# Hagyd üresen azt, amit nem használsz
# ------------------------------------------

# Discord Webhook URL (Csatorna beállítások -> Integrációk -> Webhook létrehozása)
DISCORD_WEBHOOK_URL=

# Telegram Bot adatai (@BotFather által kapott token és a saját Chat ID)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------
# DOCKER MODUL (Opcionális)
# true = figyeli a futó konténereket a sock-on keresztül
# false = kikapcsolva
# ------------------------------------------
ENABLE_DOCKER=true